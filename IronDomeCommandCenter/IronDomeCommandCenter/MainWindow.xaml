<Window x:Class="IronDomeCommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeCommandCenter"
        mc:Ignorable="d"
        Title="Iron Dome Command Center"
        WindowState="Maximized"
        Background="#0B0F14">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Background" Value="#18232F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E3EC"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- COMMAND MAP / CANVAS -->
        <!-- ===================== -->

        <Border Grid.Column="0"
                Margin="0,0,12,0"
                BorderBrush="#263746"
                BorderThickness="1"
                CornerRadius="6"
                Background="#05080B">

            <Grid>

                <Canvas x:Name="CommandCanvas"
                        Background="#05080B"/>

                <TextBlock Text="COMMAND CENTER - OPERATIONAL MAP"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#38BDF8"
                           Margin="18"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

            </Grid>

        </Border>

        <!-- ================= -->
        <!-- RIGHT SIDE PANEL -->
        <!-- ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- CONNECTION -->

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="SYSTEM STATUS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#38BDF8"/>

                    <Button x:Name="ConnectToRadar"
                            Content="CONNECT TO RADAR"
                            Click="btnConnect_Click"/>
                    <Button x:Name="btnStartInterceptorServer"
        Content="START INTERCEPTOR SERVER"
        Click="btnStartInterceptorServer_Click"/>
                    <TextBlock x:Name="txtStats"
                               Text="Radar: Disconnected"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="#F87171"/>

                </StackPanel>

            </Border>


            <!-- TARGET LIST -->

            <Border Grid.Row="1"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TRACKED TARGETS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="lstTargets"
                             Grid.Row="1"
                             SelectionChanged="lstTargets_SelectionChanged"
                             Background="#0A1016"
                             Foreground="White"
                             BorderBrush="#263746"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="12"/>

                </Grid>

            </Border>


            <!-- SELECTED TARGET -->

            <Border Grid.Row="2"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">

                <StackPanel>

                    <TextBlock Text="SELECTED TARGET"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#38BDF8"/>

                    <TextBlock x:Name="txtSelectedTarget"
                               Text="No target selected"
                               Margin="0,12,0,12"
                               FontSize="14"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"/>

                    <Button x:Name="btnIntercept"
                            Content="INTERCEPT TARGET"
                            Background="#3A1619"
                            BorderBrush="#EF4444"
                            Click="btnIntercept_Click" />
                        
                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>