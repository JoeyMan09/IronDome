<Window x:Class="IronDomeRader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeRader"
        mc:Ignorable="d"
        Title="MainWindow" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Canvas x:Name="RadarCanvas"
        Grid.Column="0"
        Background="Black"/>

        <StackPanel Grid.Column="1">
            <Button x:Name="btnStart"
            Content="Start Simulation"
            Margin="5" Click="btnStart_Click"/>

            <Button x:Name="btnSenToCommand"
            Content="Send To Command"
            Margin="5" Click="btnStartServer_Click"/>
            <Button x:Name="btnStop"
            Content="Stop Simulation"
            Margin="5" Click="btnStop_Click"/>
            <TextBlock x:Name="txtStats"
               Margin="5"
               Foreground="Black"/>
        </StackPanel>
    </Grid>
</Window>
