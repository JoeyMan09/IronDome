<Window x:Class="IronDomeRader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeRader"
        mc:Ignorable="d"
        Title="Iron Dome Radar System"
        WindowState="Maximized"
        Background="#0B0F14">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Background" Value="#18232F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E3EC"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ================= -->
        <!-- RADAR DISPLAY -->
        <!-- ================= -->

        <Border Grid.Column="0"
                Margin="0,0,12,0"
                Background="#020504"
                BorderBrush="#1F3A2A"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Canvas x:Name="RadarCanvas"
                        Background="#020504"/>

                <TextBlock Text="RADAR TRACKING SYSTEM"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#22C55E"
                           Margin="18"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

            </Grid>

        </Border>

        <!-- ================= -->
        <!-- CONTROL PANEL -->
        <!-- ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SERVER STATUS -->

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="NETWORK STATUS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#22C55E"/>

                    <Button x:Name="btnStartServer"
                            Content="START RADAR SERVER"
                            Click="btnStartServer_Click"/>

                    <TextBlock x:Name="txtStats"
                               Text="Server: Offline"
                               FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="#F87171"/>

                </StackPanel>

            </Border>

            <!-- SIMULATION CONTROLS -->

            <Border Grid.Row="1"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="SIMULATION CONTROL"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#22C55E"/>

                    <Button x:Name="btnStart"
                            Content="START SIMULATION"
                            Click="btnStart_Click"/>

                    <Button x:Name="btnStop"
                            Content="STOP SIMULATION"
                            Background="#3A1619"
                            BorderBrush="#EF4444"
                            Click="btnStop_Click"/>

                </StackPanel>

            </Border>

            <!-- TARGET ACTION -->

            <Border Grid.Row="2"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">

                <StackPanel>

                    <TextBlock Text="TARGET CONTROL"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#22C55E"/>

                    <TextBlock Text="Select a target directly on the radar display."
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"
                               Foreground="#94A3B8"/>

                    <Button x:Name="btnSenToCommand"
                            Content="SEND SELECTED TARGET TO COMMAND"
                            Background="#102A1C"
                            BorderBrush="#22C55E"
                            Click="btnSenToCommand_Click"/>

                    <Separator Margin="0,12,0,12"
                               Background="#263746"/>

                    <TextBlock Text="LEGEND"
                               FontWeight="Bold"
                               Foreground="#22C55E"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="● Supersonic Missile"
                               Foreground="Red"
                               Margin="0,2"/>

                    <TextBlock Text="● Ballistic Missile"
                               Foreground="Yellow"
                               Margin="0,2"/>

                    <TextBlock Text="● Drone"
                               Foreground="DodgerBlue"
                               Margin="0,2"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>