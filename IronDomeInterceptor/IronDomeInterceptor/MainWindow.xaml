<Window x:Class="IronDomeInterceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeInterceptor"
        mc:Ignorable="d"
        Title="Iron Dome Interceptor System"
        WindowState="Maximized"
        Background="#0B0F14">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Background" Value="#18232F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E3EC"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- INTERCEPTOR DISPLAY -->

        <Border Grid.Column="0"
                Margin="0,0,12,0"
                Background="#05080B"
                BorderBrush="#3D3420"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Canvas x:Name="InterceptorCanvas"
                        Background="#05080B"/>

                <TextBlock Text="INTERCEPTOR TRACKING SYSTEM"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#F59E0B"
                           Margin="18"/>

            </Grid>

        </Border>

        <!-- RIGHT CONTROL PANEL -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CONNECTION -->

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="COMMAND CONNECTION"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <Button x:Name="btnConnectToCommand"
                            Content="CONNECT TO COMMAND CENTER"
                            Click="btnConnectToCommand_Click"/>

                    <TextBlock x:Name="txtConnectionStatus"
                               Text="Command Center: Disconnected"
                               Foreground="#F87171"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- CURRENT COMMAND -->

            <Border Grid.Row="1"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="CURRENT INTERCEPT ORDER"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <TextBlock x:Name="txtCurrentCommand"
                               Text="No interception order received"
                               Margin="0,12,0,0"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- INTERCEPT STATUS -->

            <Border Grid.Row="2"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">

                <StackPanel>

                    <TextBlock Text="INTERCEPT STATUS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <TextBlock x:Name="txtInterceptStatus"
                               Text="System idle"
                               Margin="0,10,0,10"
                               FontFamily="Consolas"/>

                    <Button x:Name="btnAbort"
                            Content="ABORT INTERCEPT"
                            Background="#3A1619"
                            BorderBrush="#EF4444"
                            Click="btnAbort_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>