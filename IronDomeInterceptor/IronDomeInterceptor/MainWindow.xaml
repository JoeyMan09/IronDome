<Window x:Class="IronDomeInterceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeInterceptor"
        mc:Ignorable="d"
        Title="Iron Dome Interceptor System"
        WindowState="Maximized"
        Background="#0B0F14">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Background" Value="#18232F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E3EC"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ============================= -->
        <!-- INTERCEPTOR TACTICAL DISPLAY -->
        <!-- ============================= -->

        <Border Grid.Column="0"
                Margin="0,0,12,0"
                Background="#05080B"
                BorderBrush="#3D3420"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <!-- Background tactical grid -->

                <Grid Opacity="0.20"
                      IsHitTestVisible="False">

                    <Grid.Background>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,40,40"
                                      ViewportUnits="Absolute">

                            <DrawingBrush.Drawing>

                                <GeometryDrawing Brush="Transparent">

                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#374151"
                                             Thickness="0.5"/>
                                    </GeometryDrawing.Pen>

                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0"
                                                          EndPoint="40,0"/>
                                            <LineGeometry StartPoint="0,0"
                                                          EndPoint="0,40"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>

                                </GeometryDrawing>

                            </DrawingBrush.Drawing>

                        </DrawingBrush>
                    </Grid.Background>

                </Grid>

                <!-- Main simulation layer -->

                <Canvas x:Name="InterceptorCanvas"
                        Background="Transparent"/>

                <!-- Header -->

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16"
                        Padding="12,8"
                        Background="#CC111820"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="4">

                    <StackPanel>

                        <TextBlock Text="INTERCEPTOR TRACKING SYSTEM"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"/>

                        <TextBlock Text="Real-time tactical interception view"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Legend -->

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16"
                        Padding="10"
                        Background="#CC111820"
                        BorderBrush="#263746"
                        BorderThickness="1"
                        CornerRadius="4">

                    <StackPanel>

                        <TextBlock Text="LEGEND"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="● Target"
                                   Foreground="#EF4444"/>

                        <TextBlock Text="● Interceptor"
                                   Foreground="#F59E0B"/>

                        <TextBlock Text="■ Battery"
                                   Foreground="#22C55E"/>

                        <TextBlock Text="× Predicted Intercept"
                                   Foreground="#38BDF8"/>

                    </StackPanel>

                </Border>

                <!-- Center / Battery marker -->

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="14"
                        Height="14"
                        Background="#22C55E"
                        BorderBrush="White"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False"/>

            </Grid>

        </Border>

        <!-- ================= -->
        <!-- RIGHT CONTROL PANEL -->
        <!-- ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CONNECTION -->

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="COMMAND CONNECTION"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <Button x:Name="btnConnectToCommand"
                            Content="CONNECT TO COMMAND CENTER"
                            Click="btnConnectToCommand_Click"/>

                    <TextBlock x:Name="txtConnectionStatus"
                               Text="Command Center: Disconnected"
                               Foreground="#F87171"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

            <!-- CURRENT COMMAND -->

            <Border Grid.Row="1"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="CURRENT INTERCEPT ORDER"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <TextBlock x:Name="txtCurrentCommand"
                               Text="No interception order received"
                               Margin="0,12,0,0"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- LIVE TELEMETRY -->

            <Border Grid.Row="2"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="LIVE TELEMETRY"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F59E0B"/>

                    <TextBlock x:Name="txtInterceptStatus"
                               Text="System idle"
                               Margin="0,12,0,12"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <Separator Margin="0,8,0,8"
                               Background="#263746"/>

                    <TextBlock Text="INTERCEPT STATE"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <TextBlock x:Name="txtState"
                               Text="READY"
                               Foreground="#22C55E"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,2,0,10"/>

                    <TextBlock Text="DISTANCE TO TARGET"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <TextBlock x:Name="txtDistance"
                               Text="-"
                               FontFamily="Consolas"
                               FontSize="16"
                               Margin="0,2,0,10"/>

                    <TextBlock Text="TIME TO INTERCEPT"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <TextBlock x:Name="txtTimeToIntercept"
                               Text="-"
                               FontFamily="Consolas"
                               FontSize="16"/>

                </StackPanel>

            </Border>

            <!-- ABORT -->

            <Border Grid.Row="3"
                    Background="#111820"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">

                <StackPanel>

                    <Button x:Name="btnAbort"
                            Content="ABORT INTERCEPT"
                            Background="#3A1619"
                            BorderBrush="#EF4444"
                            Click="btnAbort_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>