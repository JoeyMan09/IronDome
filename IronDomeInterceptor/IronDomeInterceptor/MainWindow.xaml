<Window x:Class="IronDomeInterceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronDomeInterceptor"
        mc:Ignorable="d"
        Title="Iron Dome Interceptor System"
        WindowState="Maximized"
        Background="#070B10">

    <Window.Resources>

        <Style x:Key="InterceptorButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Background" Value="#1A1610"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Background" Value="#351316"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#101720"/>
            <Setter Property="BorderBrush" Value="#253748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D5DEE8"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="ExplosionAudio"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Visibility="Hidden"/>

        <!-- TOP BAR -->

        <Border Grid.Row="0"
                Background="#0D141D"
                BorderBrush="#263746"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="IRON DOME"
                               Foreground="#F59E0B"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="INTERCEPTOR CONTROL SYSTEM"
                               Foreground="#64748B"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="TACTICAL INTERCEPTION CONTROL"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="ENGAGEMENT / TRACKING / INTERCEPT TELEMETRY"
                               FontSize="9"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <Border Grid.Column="2"
                        Background="#1F1B10"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,7"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#F59E0B"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="INTERCEPTOR READY"
                                   Foreground="#FCD34D"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1"
              Margin="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT INFO -->

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="ENGAGEMENT STATUS"
                               Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="SYSTEM"
                               Foreground="#64748B"
                               FontSize="10"/>

                    <TextBlock Text="READY"
                               Foreground="#22C55E"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <Separator Margin="0,14"
                               Background="#263746"/>

                    <TextBlock Text="TACTICAL LEGEND"
                               Style="{StaticResource SectionHeader}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#EF4444"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="Target"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#F59E0B"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="Interceptor"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4">
                        <Rectangle Width="8"
                                   Height="8"
                                   Fill="#22C55E"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Battery"
                                   FontSize="11"/>
                    </StackPanel>

                    <TextBlock Text="✕ Predicted Intercept"
                               Foreground="#38BDF8"
                               FontSize="11"
                               Margin="0,6,0,0"/>

                    <Separator Margin="0,14"
                               Background="#263746"/>

                    <TextBlock Text="SIMULATION"
                               Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="UPDATE RATE"
                               Foreground="#64748B"
                               FontSize="10"/>

                    <TextBlock Text="50 ms"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="13"
                               Margin="0,2,0,10"/>

                    <TextBlock Text="MODE"
                               Foreground="#64748B"
                               FontSize="10"/>

                    <TextBlock Text="MULTI-TARGET"
                               Foreground="#F59E0B"
                               FontWeight="Bold"
                               FontSize="12"/>

                </StackPanel>

            </Border>

            <!-- TACTICAL VIEW -->

            <Border Grid.Column="1"
                    Background="#05080B"
                    BorderBrush="#3D3420"
                    BorderThickness="1"
                    CornerRadius="5">

                <Grid>

                    <!-- Tactical grid -->

                    <Grid Opacity="0.18"
                          IsHitTestVisible="False">

                        <Grid.Background>

                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,40,40"
                                          ViewportUnits="Absolute">

                                <DrawingBrush.Drawing>

                                    <GeometryDrawing Brush="Transparent">

                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#374151"
                                                 Thickness="0.5"/>
                                        </GeometryDrawing.Pen>

                                        <GeometryDrawing.Geometry>

                                            <GeometryGroup>

                                                <LineGeometry StartPoint="0,0"
                                                              EndPoint="40,0"/>

                                                <LineGeometry StartPoint="0,0"
                                                              EndPoint="0,40"/>

                                            </GeometryGroup>

                                        </GeometryDrawing.Geometry>

                                    </GeometryDrawing>

                                </DrawingBrush.Drawing>

                            </DrawingBrush>

                        </Grid.Background>

                    </Grid>

                    <Canvas x:Name="InterceptorCanvas"
                            Background="Transparent"/>

                    <!-- Header -->

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Background="#E6111820"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6">

                        <StackPanel>

                            <TextBlock Text="LIVE INTERCEPT VIEW"
                                       Foreground="#F59E0B"
                                       FontWeight="Bold"
                                       FontSize="14"/>

                            <TextBlock Text="REAL-TIME TARGET / INTERCEPTOR TRACKING"
                                       Foreground="#64748B"
                                       FontSize="9"/>

                        </StackPanel>

                    </Border>

                    <!-- Battery marker -->

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="14"
                            Height="14"
                            Background="#22C55E"
                            BorderBrush="White"
                            BorderThickness="1"
                            CornerRadius="2"
                            IsHitTestVisible="False"/>

                    <!-- Map status -->

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="14"
                            Background="#E6111820"
                            BorderBrush="#263746"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">

                        <StackPanel>

                            <TextBlock Text="INTERCEPT VIEW"
                                       Foreground="#F59E0B"
                                       FontWeight="Bold"/>

                            <TextBlock Text="TRACKING ENABLED"
                                       Foreground="#22C55E"
                                       FontSize="11"/>

                            <TextBlock Text="AUTO REFRESH: 50 ms"
                                       Foreground="#64748B"
                                       FontSize="10"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- RIGHT CONTROL PANEL -->

            <Grid Grid.Column="2"
                  Margin="10,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CONNECTION -->

                <Border Grid.Row="0"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="COMMAND CONNECTION"
                                   Style="{StaticResource SectionHeader}"/>

                        <Button x:Name="btnConnectToCommand"
                                Content="CONNECT TO COMMAND CENTER"
                                Style="{StaticResource InterceptorButtonStyle}"
                                Click="btnConnectToCommand_Click"/>

                        <Separator Margin="0,7"
                                   Background="#263746"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="COMMAND LINK"
                                       Foreground="#64748B"
                                       FontSize="11"/>

                            <TextBlock x:Name="txtConnectionStatus"
                                       Grid.Column="1"
                                       Text="DISCONNECTED"
                                       HorizontalAlignment="Right"
                                       Foreground="#F87171"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- CURRENT COMMAND -->

                <Border Grid.Row="1"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="CURRENT INTERCEPT ORDER"
                                   Style="{StaticResource SectionHeader}"/>

                        <Border Background="#080D13"
                                BorderBrush="#263746"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10">

                            <TextBlock x:Name="txtCurrentCommand"
                                       Text="NO INTERCEPTION ORDER RECEIVED"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- TELEMETRY -->

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,0,10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="LIVE TELEMETRY"
                                   Style="{StaticResource SectionHeader}"/>

                        <TextBlock Grid.Row="1"
                                   Text="ACTIVE INTERCEPTORS"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="0,2,0,5"/>

                        <ListBox x:Name="lstInterceptors"
                                 Grid.Row="2"
                                 SelectionChanged="lstInterceptors_SelectionChanged"
                                 Background="#080D13"
                                 Foreground="White"
                                 BorderBrush="#263746"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock x:Name="txtInterceptStatus"
                                           Text="SYSTEM IDLE"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <Separator Background="#263746"
                                           Margin="0,4,0,10"/>

                                <TextBlock Text="INTERCEPT STATE"
                                           Foreground="#64748B"
                                           FontSize="10"/>

                                <TextBlock x:Name="txtState"
                                           Text="READY"
                                           Foreground="#22C55E"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,2,0,10"/>

                                <TextBlock Text="DISTANCE TO TARGET"
                                           Foreground="#64748B"
                                           FontSize="10"/>

                                <TextBlock x:Name="txtDistance"
                                           Text="-"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           Margin="0,2,0,10"/>

                                <TextBlock Text="TIME TO INTERCEPT"
                                           Foreground="#64748B"
                                           FontSize="10"/>

                                <TextBlock x:Name="txtTimeToIntercept"
                                           Text="-"
                                           FontFamily="Consolas"
                                           FontSize="16"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                </Border>

                <!-- ABORT -->

                <Border Grid.Row="3"
                        Style="{StaticResource PanelBorder}">

                    <Button x:Name="btnAbort"
                            Content="ABORT SELECTED INTERCEPT"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="btnAbortAll_Click"/>

                </Border>

            </Grid>

        </Grid>

        <!-- BOTTOM STATUS -->

        <Border Grid.Row="2"
                Background="#0D141D"
                BorderBrush="#263746"
                BorderThickness="0,1,0,0">

            <Grid Margin="14,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="IRON DOME INTERCEPTOR SIMULATION"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="10"/>

                <TextBlock Grid.Column="1"
                           Text="COMMAND ●"
                           VerticalAlignment="Center"
                           Foreground="#38BDF8"
                           FontSize="10"
                           Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2"
                           Text="INTERCEPTOR ●"
                           VerticalAlignment="Center"
                           Foreground="#F59E0B"
                           FontSize="10"/>

            </Grid>

        </Border>

    </Grid>

</Window>