<Window x:Class="IronDomeInterceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iron Dome Interceptor System"
        WindowState="Maximized"
        Background="#070B10">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="#1A1610"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#101720"/>
            <Setter Property="BorderBrush" Value="#253748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="ExplosionAudio"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Visibility="Hidden"/>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#0D141D"
                BorderBrush="#263746"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IRON DOME"
                               Foreground="#F59E0B"
                               FontSize="23"
                               FontWeight="Bold"/>
                    <TextBlock Text="INTERCEPTOR CONTROL SYSTEM"
                               Foreground="#64748B"
                               FontSize="10"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="TACTICAL INTERCEPTION CONTROL"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="Bold"/>

                <TextBlock Grid.Column="2"
                           Text="● SYSTEM READY"
                           Foreground="#22C55E"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ENGAGEMENT STATUS"
                               Foreground="#F59E0B"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBlock Text="MANUAL INTERCEPTION"
                               Foreground="#22C55E"
                               Margin="0,10,0,15"/>

                    <Separator/>

                    <TextBlock Text="TACTICAL LEGEND"
                               Foreground="#F59E0B"
                               FontWeight="Bold"
                               Margin="0,15,0,10"/>

                    <TextBlock Text="● Hostile Target"
                               Foreground="#EF4444"
                               Margin="0,4"/>

                    <TextBlock Text="● Interceptor"
                               Foreground="#F59E0B"
                               Margin="0,4"/>

                    <TextBlock Text="● Battery"
                               Foreground="#22C55E"
                               Margin="0,4"/>

                    <TextBlock Text="✕ Predicted Intercept"
                               Foreground="#38BDF8"
                               Margin="0,4"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="SIMULATION"
                               Foreground="#F59E0B"
                               FontWeight="Bold"/>

                    <TextBlock Text="UPDATE RATE: 50 ms"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="MODE: MULTI-TARGET"
                               Foreground="#F59E0B"/>

                    <TextBlock Text="Launches require manual approval"
                               TextWrapping="Wrap"
                               Foreground="#94A3B8"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <!-- MAP -->
            <Border Grid.Column="1"
                    Background="#05080B"
                    BorderBrush="#3D3420"
                    BorderThickness="1"
                    CornerRadius="5">

                <Grid>
                    <Canvas x:Name="InterceptorCanvas"
                            Background="Transparent"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Background="#E6111820"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            Padding="10,6">
                        <StackPanel>
                            <TextBlock Text="LIVE INTERCEPT VIEW"
                                       Foreground="#F59E0B"
                                       FontWeight="Bold"/>
                            <TextBlock Text="REAL-TIME TRACKING"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CONNECTION -->
                <Border Grid.Row="0"
                        Style="{StaticResource PanelStyle}"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="COMMAND CONNECTION"
                                   Foreground="#F59E0B"
                                   FontWeight="Bold"/>

                        <Button x:Name="btnConnectToCommand"
                                Content="CONNECT TO COMMAND CENTER"
                                Style="{StaticResource ActionButton}"
                                Click="btnConnectToCommand_Click"/>

                        <TextBlock x:Name="txtConnectionStatus"
                                   Text="DISCONNECTED"
                                   Foreground="#F87171"/>
                    </StackPanel>
                </Border>

                <!-- COMMAND -->
                <Border Grid.Row="1"
                        Style="{StaticResource PanelStyle}"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="CURRENT INTERCEPT ORDER"
                                   Foreground="#F59E0B"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="txtCurrentCommand"
                                   Text="NO INTERCEPTION ORDER RECEIVED"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TARGETS + TELEMETRY -->
                <Border Grid.Row="2"
                        Style="{StaticResource PanelStyle}"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="DETECTED TARGETS"
                                   Foreground="#F59E0B"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="lstTargets"
                                 Grid.Row="1"
                                 Background="#080D13"
                                 Foreground="White"
                                 BorderBrush="#263746"/>

                        <Button Grid.Row="2"
                                Content="INTERCEPT SELECTED"
                                Style="{StaticResource ActionButton}"
                                Click="btnInterceptSelected_Click"/>

                        <Button Grid.Row="3"
                                Content="INTERCEPT ALL"
                                Style="{StaticResource ActionButton}"
                                Click="btnInterceptAll_Click"/>

                        <TextBlock Grid.Row="4"
                                   Text="ACTIVE INTERCEPTORS"
                                   Foreground="#F59E0B"
                                   FontWeight="Bold"
                                   Margin="0,12,0,6"/>

                        <ListBox x:Name="lstInterceptors"
                                 Grid.Row="5"
                                 Background="#080D13"
                                 Foreground="White"
                                 BorderBrush="#263746"
                                 SelectionChanged="lstInterceptors_SelectionChanged"/>

                        <ScrollViewer Grid.Row="6"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="txtInterceptStatus"
                                           Text="SYSTEM IDLE"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="INTERCEPT STATE"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtState"
                                           Text="READY"
                                           Foreground="#22C55E"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,2,0,10"/>

                                <TextBlock Text="DISTANCE TO TARGET"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtDistance"
                                           Text="-"
                                           Foreground="White"
                                           FontSize="16"
                                           Margin="0,2,0,10"/>

                                <TextBlock Text="TIME TO INTERCEPT"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtTimeToIntercept"
                                           Text="-"
                                           Foreground="White"
                                           FontSize="16"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Style="{StaticResource PanelStyle}">
                    <Button x:Name="btnAbort"
                            Content="ABORT ALL INTERCEPTORS"
                            Background="#351316"
                            Foreground="#FCA5A5"
                            BorderBrush="#EF4444"
                            Height="44"
                            FontWeight="Bold"
                            Click="btnAbortAll_Click"/>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#0D141D"
                BorderBrush="#263746"
                BorderThickness="0,1,0,0">

            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBoom"
                        Grid.Column="0"
                        Content="BOOM"
                        Width="40"
                        Height="20"
                        Click="btnBoom_Click"/>

                <TextBlock Grid.Column="1"
                           Text="IRON DOME INTERCEPTOR SIMULATION"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <TextBlock Grid.Column="2"
                           Text="COMMAND ●  INTERCEPTOR ●"
                           Foreground="#F59E0B"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MISSION FAILED OVERLAY -->
        <Grid x:Name="MissionFailedOverlay"
              Grid.RowSpan="3"
              Background="#F0200505"
              Visibility="Collapsed"
              Panel.ZIndex="1000">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="⚠"
                           FontSize="70"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="MISSION FAILED"
                           FontSize="52"
                           FontWeight="ExtraBold"
                           Foreground="#FF5555"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="INTERCEPTION FAILED"
                           FontSize="25"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>

                <TextBlock x:Name="txtFailedTarget"
                           FontSize="17"
                           Foreground="#FFB1B1"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,25,0,0"/>

                <TextBlock Text="CASUALTIES REPORTED"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>

                <TextBlock Text="SIMULATION TERMINATED"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>